# Page d'erreur du site
ErrorDocument 404 /404.html

# Fichiers compilés d'Astro (noms uniques) : gardés en cache un an
<IfModule mod_headers.c>
  <FilesMatch "^.*\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compression des fichiers texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

---
// Diapositives en cartes repliables : la carte ouverte montre la diapo en entier, les autres sont de fines bandes.
import type { Photo } from '../../data/projets';
const { photos } = Astro.props as { photos: Photo[] };
const num = (i: number) => String(i + 1).padStart(2, '0');
// Œuvre de manga ou d'anime citée en fin de description : on l'affiche dans la légende.
const manga = (alt: string) => alt.match(/Manga[\s\u00a0\u202f]*: (.+?)\.?$/)?.[1];
const legende = (p: Photo) => (manga(p.alt) ? `${p.sujet} · Manga : ${manga(p.alt)}` : p.sujet);
---

<div class="diapos" data-diapos>
  <div class="diapos__rang">
    {photos.map((p, i) => (
      <article class="diapos__carte" data-actif={i === 0 ? 'true' : 'false'} tabindex="0" aria-label={`Diapositive ${i + 1} : ${legende(p)}`}>
        <img src={`/images/${p.fichier}`} alt={p.alt} width="1920" height="1080" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        <span class="diapos__num" aria-hidden="true">{num(i)}</span>
      </article>
    ))}
  </div>
  <p class="diapos__legende" aria-live="polite"><span data-num>01</span> / {num(photos.length - 1)} <span class="diapos__texte" data-legende>{legende(photos[0])}</span></p>
  <script type="application/json" data-sujets set:html={JSON.stringify(photos.map(legende))} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-diapos]').forEach((r) => {
    const cartes = Array.from(r.querySelectorAll<HTMLElement>('.diapos__carte'));
    const num = r.querySelector('[data-num]')!;
    const leg = r.querySelector('[data-legende]')!;
    const sujets: string[] = JSON.parse(r.querySelector('[data-sujets]')!.textContent || '[]');
    const activer = (i: number) => {
      cartes.forEach((c, k) => (c.dataset.actif = String(k === i)));
      num.textContent = String(i + 1).padStart(2, '0');
      leg.textContent = sujets[i] || '';
    };
    const ouvrir = (img: HTMLImageElement) => {
      const zoom = document.getElementById('zoom') as HTMLDialogElement | null;
      if (!zoom) return;
      const grande = zoom.querySelector('img') as HTMLImageElement;
      grande.src = img.currentSrc || img.src; grande.alt = img.alt;
      (zoom.querySelector('.zoom__legende') as HTMLElement).textContent = img.alt;
      zoom.classList.add('zoom--seule');
      zoom.showModal();
    };
    cartes.forEach((c, i) => {
      c.addEventListener('click', () => {
        if (c.dataset.actif !== 'true') activer(i); else ouvrir(c.querySelector('img')!);
      });
      c.addEventListener('mouseenter', () => { if (window.matchMedia('(hover: hover)').matches) activer(i); });
      c.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); if (c.dataset.actif !== 'true') activer(i); else ouvrir(c.querySelector('img')!); }
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (d) { e.preventDefault(); const k = (i + d + cartes.length) % cartes.length; cartes[k].focus(); activer(k); }
      });
    });
  });
</script>

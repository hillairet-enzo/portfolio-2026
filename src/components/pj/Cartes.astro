---
// Visionneuse d'affiches en cartes : la carte ouverte montre l'affiche et son texte, les autres sont repliées.
// Chaque photo : sujet = « Nom du lieu | Accroche | Description courte ».
import type { Photo } from '../../data/projets';
const { photos } = Astro.props as { photos: Photo[] };
const items = photos.map((p) => {
  const [nom, accroche, texte] = p.sujet.split('|').map((s) => s.trim());
  return { ...p, nom, accroche, texte };
});
---

<div class="cartes" data-cartes>
  {items.map((it, i) => (
    <article class="carte" data-actif={i === 0 ? 'true' : 'false'} tabindex="0" aria-label={`Affiche ${i + 1} : ${it.nom}`}>
      <img class="carte__img" src={`/images/${it.fichier}`} alt={it.alt} width="1200" height="1800" loading="lazy" decoding="async" />
      <span class="carte__voile" aria-hidden="true"></span>
      <ul class="carte__tags" aria-hidden="true">
        <li>Affiche {String(i + 1).padStart(2, '0')}</li>
        <li>40 × 60 cm</li>
      </ul>
      <span class="carte__rond" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"></path></svg>
      </span>
      <div class="carte__texte">
        <h4 class="carte__nom">{it.nom}</h4>
        <p class="carte__accroche">« {it.accroche} »</p>
        <p class="carte__desc">{it.texte}</p>
        <button type="button" class="carte__bouton" data-grand>
          Voir l’affiche en grand
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </article>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cartes]').forEach((racine) => {
    const cartes = Array.from(racine.querySelectorAll<HTMLElement>('.carte'));
    const activer = (c: HTMLElement) => cartes.forEach((x) => (x.dataset.actif = String(x === c)));
    cartes.forEach((c, i) => {
      // carte repliée : un clic l'ouvre (sans rien déclencher d'autre)
      c.addEventListener('click', (e) => {
        if (c.dataset.actif !== 'true') { e.stopPropagation(); activer(c); }
      }, true);
      c.addEventListener('keydown', (e) => {
        if (e.target !== c) return;
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activer(c); }
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); cartes[(i + 1) % cartes.length].focus(); activer(cartes[(i + 1) % cartes.length]); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); cartes[(i - 1 + cartes.length) % cartes.length].focus(); activer(cartes[(i - 1 + cartes.length) % cartes.length]); }
      });
      c.addEventListener('mouseenter', () => { if (window.matchMedia('(hover: hover)').matches) activer(c); });
      c.querySelector('[data-grand]')?.addEventListener('click', () => {
        const zoom = document.getElementById('zoom') as HTMLDialogElement | null;
        const img = c.querySelector('img')!;
        if (!zoom) return;
        const grande = zoom.querySelector('img') as HTMLImageElement;
        grande.src = img.currentSrc || img.src;
        grande.alt = img.alt;
        (zoom.querySelector('.zoom__legende') as HTMLElement).textContent = img.alt;
        zoom.classList.add('zoom--seule');
        zoom.showModal();
      });
    });
  });
</script>

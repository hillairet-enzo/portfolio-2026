---
/* Filtres de réfraction « Liquid Glass » : une carte de déplacement stockée en image,
   étirée sur la boîte de l'élément (primitiveUnits = objectBoundingBox). */
---
<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true" focusable="false">
  <defs>
    <filter id="lg-pill" color-interpolation-filters="sRGB" x="0" y="0" width="1" height="1" primitiveUnits="objectBoundingBox">
      <feImage result="carte" x="0" y="0" width="1" height="1" preserveAspectRatio="none" href="data:image/png;base64,"></feImage>
      <feDisplacementMap in="SourceGraphic" in2="carte" scale="0.12" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
    <filter id="lg-carte" color-interpolation-filters="sRGB" x="0" y="0" width="1" height="1" primitiveUnits="objectBoundingBox">
      <feImage result="carte" x="0" y="0" width="1" height="1" preserveAspectRatio="none" href="data:image/png;base64,"></feImage>
      <feDisplacementMap in="SourceGraphic" in2="carte" scale="0.14" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
    <filter id="lg-barre" color-interpolation-filters="sRGB" x="0" y="0" width="1" height="1" primitiveUnits="objectBoundingBox">
      <feImage result="carte" x="0" y="0" width="1" height="1" preserveAspectRatio="none" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAACACAIAAAC5jr9pAAAAj0lEQVR4Xu2XzQ6AIAyD0fjgvLbiX7x4cZ+mpPG0HWnakmVAGWqrJaqpzOF6F7CQlBFosgcyVpJChi6FHghstCudgVII7GSuM1BKBw7aFQLoAYwxdriOgWqOUgk8KluSLbkrhyGH4XsY8EI2jo/x0n+RUt+oHin9rTUmAD1+GLOPHrz+iIPG9GrM1Chl+xucETJFioMZsdMAAAAASUVORK5CYII="></feImage>
      <feDisplacementMap in="SourceGraphic" in2="carte" scale="0.55" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
  </defs>
</svg>

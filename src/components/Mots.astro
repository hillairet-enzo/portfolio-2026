---
// Mots géants en quinconce avec une image inclinée posée par-dessus (comme sur la référence « Tenista »).
import Photo from './Photo.astro';
import type { Photo as PhotoType } from '../data/projets';

interface Props {
  mots: string[]; // un mot par ligne
  photo: PhotoType;
}
const { mots, photo } = Astro.props;
---

<div class="mots">
  <p class="mots__lignes" aria-label={mots.join(', ')}>
    {mots.map((m, i) => <span class:list={['mots__ligne', { 'mots__ligne--fort': i % 2 === 1 }]} aria-hidden="true">{m}</span>)}
  </p>
  <div class="mots__photo" aria-hidden="true">
    <Photo photo={photo} serre />
  </div>
</div>

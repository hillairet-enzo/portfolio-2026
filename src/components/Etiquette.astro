---
// Repère de section : lettre dans un rond, filet, nom de la section.
interface Props {
  lettre: string;
  texte: string;
}
const { lettre, texte } = Astro.props;
---

<p class="etiquette">
  <span class="etiquette__lettre" aria-hidden="true">{lettre}</span>
  <span class="etiquette__trait" aria-hidden="true"></span>
  <span class="etiquette__texte">{texte}</span>
</p>

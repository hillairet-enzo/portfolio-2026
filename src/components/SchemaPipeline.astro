---
// Chaîne de traitement des données de ThermoViz, d'après la page Méthode et scripts/preparer-donnees.mjs.
const sources = [
  { t: 'Insee, Filosofi', d: 'Ménages et pauvreté, par 200 m' },
  { t: 'Cerema', d: 'Types de zones urbaines (LCZ)' },
  { t: 'Bordeaux Métropole', d: 'Contours des 28 communes' },
  { t: 'Bordeaux Métropole', d: 'Température du sol, 17 juin 2022' },
];
const etapes = [
  'Relier chaque zone à sa commune',
  'Ajouter son type de zone (LCZ)',
  'Calculer la température moyenne',
  'Garder les colonnes utiles',
];
const fichiers = ['zones.json', 'communes.json', 'contours.json', 'distribution.json', 'comparaison.json'];
---

<figure class="schema">
  <div class="schema__defil">
    <svg viewBox="0 0 1110 440" role="img" aria-labelledby="pipe-titre pipe-desc">
      <title id="pipe-titre">Du jeu de données brut aux visualisations</title>
      <desc id="pipe-desc">
        Quatre sources publiques (Insee, Cerema, Bordeaux Métropole) passent par un script de préparation en quatre étapes. Il produit cinq fichiers JSON qui alimentent les cinq visualisations du site.
      </desc>
      <defs>
        <marker id="pointe2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" class="s-pointe" />
        </marker>
      </defs>

      {sources.map((s, i) => (
        <g>
          <rect x="10" y={20 + i * 88} width="300" height="70" rx="12" class="s-table" />
          <text x="30" y={50 + i * 88} class="s-nom s-nom--sombre">{s.t}</text>
          <text x="30" y={74 + i * 88} class="s-col">{s.d}</text>
          <path d={`M310 ${55 + i * 88} H 400`} class="s-lien" marker-end="url(#pointe2)" />
        </g>
      ))}

      <rect x="402" y="20" width="340" height="334" rx="14" class="s-fort" />
      <text x="424" y="56" class="s-nom">Script de préparation</text>
      <text x="424" y="82" class="s-code s-code--clair">scripts/preparer-donnees.mjs</text>
      {etapes.map((e, i) => (
        <g>
          <circle cx="438" cy={132 + i * 56} r="15" class="s-rond" />
          <text x="438" y={138 + i * 56} class="s-num" text-anchor="middle">{i + 1}</text>
          <text x="464" y={138 + i * 56} class="s-col s-col--clair">{e}</text>
        </g>
      ))}

      <path d="M742 150 H 820" class="s-lien" marker-end="url(#pointe2)" />

      <rect x="822" y="20" width="278" height="200" rx="12" class="s-table" />
      <text x="842" y="54" class="s-nom s-nom--sombre">Fichiers du site</text>
      {fichiers.map((f, i) => (
        <text x="842" y={90 + i * 26} class="s-code">{f}</text>
      ))}

      <path d="M961 220 V 270" class="s-lien" marker-end="url(#pointe2)" />
      <rect x="822" y="272" width="278" height="82" rx="12" class="s-fort" />
      <text x="842" y="306" class="s-nom">Le site</text>
      <text x="842" y="334" class="s-col s-col--clair">5 visualisations</text>

      <text x="10" y="402" class="s-note">Aucun fichier brut n'est publié : seuls ces fichiers préparés sont dans le dépôt.</text>
    </svg>
  </div>
  <figcaption>Quatre sources publiques, un script de préparation, cinq fichiers : tout ce que le site affiche peut être refait à partir du notebook Observable.</figcaption>
</figure>

---
import Layout from '../layouts/Layout.astro';
import { profil } from '../data/profil';
import PageHero from '../components/PageHero.astro';
import { THEME_NEUTRE } from '../lib/theme';

const couleurs = THEME_NEUTRE;
---

<Layout titre="Mentions légales" description="Mentions légales du portfolio d’Enzo Hillairet." page="autre" theme={couleurs}>
  <PageHero titre={['Mentions', 'légales']} taille="moyen" />
  <div class="contenu page-texte">
    <section>
      <h2 class="titre-m">Éditeur du site</h2>
      <p>{profil.nom}, étudiant en BUT MMI, {profil.ville}. Contact : <a class="lien" href={`mailto:${profil.email}`}>{profil.email}</a>.</p>
    </section>
    <section>
      <h2 class="titre-m">Hébergement</h2>
      <p>{profil.hebergeur}</p>
    </section>
    <section>
      <h2 class="titre-m">Propriété intellectuelle</h2>
      <p>
        Les textes, schémas et mises en page de ce site sont la propriété de leur auteur. Les projets présentés ont été réalisés dans le cadre du BUT MMI, certains en binôme. Certains visuels du projet TiK•TaK ont été générés par intelligence artificielle.
      </p>
    </section>
    <section>
      <h2 class="titre-m">Crédits</h2>
      <p>
        Conception, rédaction et développement : {profil.nom}. Site construit avec <a class="lien" href="https://astro.build" rel="noopener">Astro</a> (licence MIT).
        Police <a class="lien" href="https://rsms.me/inter/" rel="noopener">Inter</a> de Rasmus Andersson (licence SIL OFL 1.1), distribuée via Fontsource.
        Effets de ligne fine : bibliothèque <a class="lien" href="https://hairline.lucasmarkes.com" rel="noopener">Hairline</a> de Lucas Markes (licence MIT).
        Les images des projets sont des captures et des visuels réalisés pour ces projets ; certains visuels de TiK•TaK ont été générés par intelligence artificielle.
      </p>
    </section>
    <section>
      <h2 class="titre-m">Données personnelles</h2>
      <p>
        Ce site ne dépose aucun cookie et n’utilise aucun outil de mesure d’audience. Il ne collecte aucune donnée : les seules informations que je reçois sont celles que vous choisissez de m’envoyer par e-mail, et je ne les utilise que pour vous répondre.
      </p>
    </section>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Contact from '../components/Contact.astro';
import { projets } from '../data/projets';
import { THEME_NEUTRE } from '../lib/theme';
import { profil } from '../data/profil';

// Un projet = une carte ; le premier est au centre de la galerie.
const cartes = projets.map((p, i, tous) => ({ projet: p, numero: i + 1, k: i }));
const avant = 0;
// Ligne sous chaque carte : la nature du projet (plus parlante qu'un code de module) et l'année.
const nature = (p: { cadre: string }) => (/perso/i.test(p.cadre) ? 'Projet personnel' : 'Projet universitaire');
const an = (p: { annee: string }) => p.annee.match(/\d{4}/)?.[0] ?? p.annee;
---

<Layout
  titre="Projets"
  titreSeo="Enzo Hillairet – Portfolio communication, création et UX"
  description="Portfolio d’Enzo Hillairet, étudiant en BUT MMI à Montbéliard : identité visuelle, sites web, data-visualisation et vidéo. En recherche de stage en communication."
  page="projet"
  theme={THEME_NEUTRE}
  claire
>
  <section class="galerie" data-vue="galerie" aria-labelledby="titre-galerie">
    <div class="galerie__tete">
      <h1 id="titre-galerie"><span>Curieux de voir</span> ce que j’ai créé&nbsp;?</h1>
      <div class="bascule" role="group" aria-label="Façon d’afficher les projets">
        <span class="bascule__pastille" aria-hidden="true"></span>
        <button type="button" data-vue-bouton="galerie" aria-pressed="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="4.5" height="12" rx="1.2"></rect><rect x="9.75" y="4" width="4.5" height="16" rx="1.2"></rect><rect x="16.5" y="6" width="4.5" height="12" rx="1.2"></rect></svg>
          Galerie
        </button>
        <button type="button" data-vue-bouton="liste" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"></path></svg>
          Liste
        </button>
      </div>
    </div>

    <div class="arc-vue">
      <ul class="arc" data-arc data-depart={avant} aria-label="Projets : faites défiler horizontalement, en boucle" tabindex="0">
        {
          cartes.map((c) =>
            c.projet ? (
              <li class="arc__carte" style={`--k:${c.k}`}>
                <a href={`/projets/${c.projet.slug}`} class="arc__lien" draggable="false">
                  <div class="arc__scene">
                    <div class="arc__img">
                      <Photo photo={{ ...c.projet.couverture, format: '4/3' }} />
                    </div>
                  </div>
                  <p class="arc__label"><span>0{c.numero}</span>{c.projet.titre}</p>
                  <p class="arc__meta">{nature(c.projet)} · {an(c.projet)}</p>
                </a>
              </li>
            ) : null,
          )
        }
      </ul>
    </div>

    <div class="liste" id="liste-projets">
      <ol>
        {
          projets.map((p, i) => (
            <li style={`--i:${i}`}>
              <a href={`/projets/${p.slug}`}>
                <span class="liste__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="liste__img"><Photo photo={{ ...p.couverture, format: '4/3' }} serre /></span>
                <span class="liste__corps">
                  <strong>{p.titre}</strong>
                  <span>{p.accroche}</span>
                </span>
                <span class="liste__meta">{nature(p)} · {an(p)}</span>
                <span class="liste__outils">{p.outils.slice(0, 3).join(' · ')}</span>
                <span class="liste__fleche" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"></path></svg>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Contact />

  <script>
    import '../scripts/arc.ts';

    // bascule galerie / liste
    const section = document.querySelector<HTMLElement>('.galerie');
    const boutons = document.querySelectorAll<HTMLButtonElement>('[data-vue-bouton]');
    const bascule = document.querySelector<HTMLElement>('.bascule');
    function pastille() {
      const actif = document.querySelector<HTMLElement>('[data-vue-bouton][aria-pressed="true"]');
      if (!bascule || !actif) return;
      bascule.style.setProperty('--x', actif.offsetLeft + 'px');
      bascule.style.setProperty('--w', actif.offsetWidth + 'px');
    }
    function montrer(vue: string) {
      if (!section) return;
      section.dataset.vue = vue;
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vueBouton === vue)));
      pastille();
      try {
        localStorage.setItem('vue-projets', vue);
      } catch {}
    }
    boutons.forEach((b) => b.addEventListener('click', () => montrer(b.dataset.vueBouton ?? 'galerie')));
    try {
      const memo = localStorage.getItem('vue-projets');
      if (memo === 'liste') montrer('liste');
    } catch {}
    pastille();
    addEventListener('resize', pastille);
    document.fonts?.ready.then(pastille);
    addEventListener('load', pastille);
  </script>
</Layout>

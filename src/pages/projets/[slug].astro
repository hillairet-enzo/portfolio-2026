---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Contact from '../../components/Contact.astro';
import Ligne from '../../components/pj/LigneProjet.astro';
import Icone from '../../components/pj/Icone.astro';
import Cartes from '../../components/pj/Cartes.astro';
import { THEME_NEUTRE, couleurMoyenne } from '../../lib/theme';
import { projets, trouverProjet, gabarits } from '../../data/projets';

export function getStaticPaths() {
  return projets.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const projet = trouverProjet(slug!)!;
const suivant = projets[(projets.indexOf(projet) + 1) % projets.length];
// Page sobre noir et blanc ; seule la ligne de progression prend la couleur du hero.
const couleurs = `${THEME_NEUTRE}--ligne:${await couleurMoyenne(projet.couverture.fichier)};`;
const lien = projet.liens[0];
// Quatre blocs, toujours dans le même ordre, chacun sur un panneau de couleur (comme la page À propos).
const teintes = [
  { fond: '#3346ff', sombre: true },
  { fond: '#d4f23c', sombre: false },
  { fond: '#7c3aed', sombre: true },
  { fond: '#ffb8d4', sombre: false },
];
const gabarit = gabarits[projet.type];
// Projet « affiche » : les images nommées affiche-* forment une série vue une par une, hors des onglets.
const estAffiche = (f: string) => /\/affiche-/.test('/' + f);
const serie = projet.type === 'affiche' ? projet.sections.flatMap((s) => s.photos ?? []).filter((ph) => estAffiche(ph.fichier)) : [];
const sectionsVisibles = projet.sections
  .map((s) => (serie.length ? { ...s, photos: s.photos?.filter((ph) => !estAffiche(ph.fichier)) } : s))
  .filter((s) => s.paragraphes.length || s.flux || s.chiffres || s.visuel || s.schemas || s.photos?.length);
// Quatre onglets : le dernier regroupe les choix (techniques ou créatifs) et le résultat.
const blocs = [
  { id: 'contexte', onglets: ['contexte'] },
  { id: 'role', onglets: ['role'] },
  { id: 'processus', onglets: ['processus'] },
  { id: 'choix', onglets: ['choix', 'resultat'] },
].map((b, i) => ({
  ...b,
  titre: gabarit.onglets[i],
  sections: sectionsVisibles.filter((s) => (b.onglets as string[]).includes(s.onglet)),
  ...teintes[i],
}));
---

<Layout titre={projet.titre} description={projet.resume} page="projet" claire theme={couleurs}>
  <!-- Ouverture : titre pleine largeur, grande photo nette, badge qui tourne -->
  <section class="ph" aria-labelledby="titre-projet">
    <div class="contenu ph-grille">
      <div class="ph-gauche">
        <p class="pp-etiquette">Projet · {projet.annee}</p>
      <h1 id="titre-projet" class="ph-titre">
        {
          lien ? (
            <a class="ph-titre__lien" href={lien.url} target="_blank" rel="noopener" aria-label={`${projet.titre} : ${lien.label} (nouvel onglet)`}>
              <span>{projet.titre}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
            </a>
          ) : (
            <span>{projet.titre}</span>
          )
        }
      </h1>
        <p class="ph-chapo">{projet.accroche}</p>
      </div>
      <div class="ph-photo">
        <Photo photo={{ ...projet.couverture, format: '4/3' }} prioritaire />
      </div>
    </div>
  </section>

  <article class="pp" id="projet">
    <section class="pp-onglets" aria-label="Informations sur le projet">
      <div class="contenu">

        <!-- Onglets : on ouvre, les informations se déroulent -->
        <h2 class="pp-onglets__titre">En détail</h2>
        <div class="pp-tabs" id="pp-tabs">
          {
            blocs.map((b, i) => (
              <div class="pp-tab" id={`bloc-${b.id}`} data-ouvert="false" style={`--i:${i}`}>
                <h3>
                  <button type="button" class="pp-tab__bouton" aria-expanded="false" aria-controls={`pan-${b.id}`} id={`btn-${b.id}`}>
                    <span class="pp-lettre" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="pp-tab__nom">{b.titre}</span>
                    <span class="pp-tab__icone" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="pp-tab__panneau" id={`pan-${b.id}`} role="region" aria-labelledby={`btn-${b.id}`} inert>
                  <div class="pp-tab__interieur">
                    {b.id === 'choix' && (
                      <>
                        <h4 class="pp-sous-titre">{gabarit.choix}</h4>
                        <ul class="pp-outils">
                          {projet.choix.map((c) => (
                            <li class="pp-outil">
                              <span class="pp-outil__icone"><Icone nom={c.icone} /></span>
                              <strong>{c.nom}</strong>
                              <span>{c.raison}</span>
                            </li>
                          ))}
                        </ul>
                      </>
                    )}
                    {b.sections.filter((sec) => sec.onglet !== 'resultat').map((sec) => <Ligne sec={sec} />)}
                    {b.id === 'contexte' && projet.defis.length > 0 && (
                      <div class="pp-defis">
                        <h4 class="pp-sous-titre">Défis et solutions</h4>
                        <ol class="pp-defis__liste">
                          {projet.defis.map((d, k) => (
                            <li class="pp-defi">
                              <span class="pp-defi__num" aria-hidden="true">{String(k + 1).padStart(2, '0')}</span>
                              <div class="pp-defi__defi"><span class="pp-defi__label">Défi</span><p>{d.defi}</p></div>
                              <div class="pp-defi__solution"><span class="pp-defi__label">Solution</span><p>{d.solution}</p></div>
                            </li>
                          ))}
                        </ol>
                      </div>
                    )}
                    {b.id === 'choix' && (
                      <>
                        <h4 class="pp-sous-titre">{gabarit.resultat}</h4>
                        {serie.length > 0 && <Cartes photos={serie} />}
                        {b.sections.filter((sec) => sec.onglet === 'resultat').map((sec) => <Ligne sec={sec} />)}
                        {projet.liens.length > 0 && (
                          <div class="pp-raccourcis">
                            {projet.liens.map((l, k) => (
                              <a class:list={['pp-raccourci', k === 0 && 'pp-raccourci--plein']} href={l.url} target="_blank" rel="noopener">
                                {l.label}
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
                              </a>
                            ))}
                          </div>
                        )}
                      </>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <div class="contenu pp-next-zone">
      <a class="pp-next" href={`/projets/${suivant.slug}`} aria-label={`Projet suivant : ${suivant.titre}`}>
        <div class="pp-next__texte">
          <span class="pp-next__label">Projet suivant</span>
          <strong class="pp-next__titre">{suivant.titre}</strong>
          <span class="pp-next__accroche">{suivant.accroche}</span>
          <span class="pp-next__cta">
            Découvrir
            <span class="pp-next__rond" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
          </span>
        </div>
        <div class="pp-next__photo"><Photo photo={{ ...suivant.couverture, format: '3/2' }} serre /></div>
      </a>
    </div>
  </article>

  <Contact />
</Layout>

<dialog class="zoom" id="zoom" aria-label="Image en grand">
  <button type="button" class="zoom__bouton zoom__fermer" aria-label="Fermer l’image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
  <button type="button" class="zoom__bouton zoom__prec" aria-label="Image précédente">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
  </button>
  <button type="button" class="zoom__bouton zoom__suiv" aria-label="Image suivante">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
  </button>
  <figure class="zoom__figure">
    <img alt="" />
    <figcaption class="zoom__legende"></figcaption>
  </figure>
</dialog>

<script>
  // Clic sur une image : elle s'ouvre en grand, on peut passer à la suivante (flèches, clavier)
  const zoom = document.getElementById('zoom') as HTMLDialogElement | null;
  if (zoom) {
    const grande = zoom.querySelector('img') as HTMLImageElement;
    const legende = zoom.querySelector('.zoom__legende') as HTMLElement;
    const images = Array.from(document.querySelectorAll<HTMLImageElement>('img[data-zoom]'));
    let courante = 0;
    const afficher = (i: number) => {
      courante = (i + images.length) % images.length;
      const img = images[courante];
      grande.src = img.currentSrc || img.src;
      grande.alt = img.alt;
      legende.textContent = img.alt;
      zoom.classList.toggle('zoom--seule', images.length < 2);
    };
    images.forEach((img, i) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      const ouvrir = () => { afficher(i); zoom.showModal(); };
      img.addEventListener('click', ouvrir);
      img.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); ouvrir(); } });
    });
    zoom.querySelector('.zoom__fermer')?.addEventListener('click', () => zoom.close());
    zoom.querySelector('.zoom__prec')?.addEventListener('click', () => afficher(courante - 1));
    zoom.querySelector('.zoom__suiv')?.addEventListener('click', () => afficher(courante + 1));
    zoom.addEventListener('click', (e) => { if (e.target === zoom) zoom.close(); });
    zoom.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') afficher(courante - 1);
      if (e.key === 'ArrowRight') afficher(courante + 1);
    });
  }
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('.pp-tab'));
  const fermer = (t: HTMLElement) => {
    t.dataset.ouvert = 'false';
    t.querySelector('.pp-tab__bouton')?.setAttribute('aria-expanded', 'false');
    t.querySelector('.pp-tab__panneau')?.setAttribute('inert', '');
  };
  const ouvrir = (t: HTMLElement, defiler = true) => {
    tabs.forEach((x) => x !== t && fermer(x));
    t.dataset.ouvert = 'true';
    t.querySelector('.pp-tab__bouton')?.setAttribute('aria-expanded', 'true');
    t.querySelector('.pp-tab__panneau')?.removeAttribute('inert');
    if (defiler) {
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => t.scrollIntoView({ behavior: reduit ? 'auto' : 'smooth', block: 'start' }), reduit ? 0 : 640);
    }
  };
  tabs.forEach((t) => {
    t.querySelector('.pp-tab__bouton')?.addEventListener('click', () => {
      if (t.dataset.ouvert === 'true') fermer(t);
      else ouvrir(t);
    });
  });
  // léger décalage de la photo du haut pendant le défilement
  const img = document.querySelector<HTMLElement>('.ph-photo img');
  if (img && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let attente = false;
    const maj = () => {
      attente = false;
      const y = Math.min(window.scrollY, 700);
      img.style.transform = `translate3d(0, ${y * 0.08}px, 0) scale(1.1)`;
    };
    window.addEventListener('scroll', () => { if (!attente) { attente = true; requestAnimationFrame(maj); } }, { passive: true });
    maj();
  }

  // flèches haut/bas, début/fin : on passe d'un onglet à l'autre au clavier
  const boutons = tabs.map((t) => t.querySelector<HTMLButtonElement>('.pp-tab__bouton')!);
  boutons.forEach((b, i) => b.addEventListener('keydown', (e) => {
    const k = e.key;
    const vers = k === 'ArrowDown' ? (i + 1) % boutons.length : k === 'ArrowUp' ? (i - 1 + boutons.length) % boutons.length : k === 'Home' ? 0 : k === 'End' ? boutons.length - 1 : -1;
    if (vers >= 0) { e.preventDefault(); boutons[vers].focus(); }
  }));
  const h = location.hash.replace('#', '');
  const cible = h && tabs.find((t) => t.id === h);
  if (cible) ouvrir(cible, false);
</script>

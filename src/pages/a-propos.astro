---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Contact from '../components/Contact.astro';
import { THEME_NEUTRE } from '../lib/theme';
import { profil, competences, skillsIA, demarche, parcours } from '../data/profil';
import { aCv } from '../lib/cv';
import galerie from '../data/galerie.json';

const couleurs = `${THEME_NEUTRE}--ligne:#15171a;`;

// Galerie : les 25 épingles du tableau Pinterest « portfolio » (liste dans src/data/galerie.json).
// 24 images = 8 colonnes de 3, pour que la bande finisse proprement.
const photos = {
  portrait: {
    fichier: 'a-propos/portrait.jpg',
    alt: 'Portrait d’Enzo Hillairet',
    sujet: 'Ton portrait : de face ou de trois quarts, lumière douce, sourire naturel. Cadre à la poitrine, avec un peu d’espace au-dessus de la tête.',
    format: '3/4' as const,
    taille: '1500 × 2000 px',
  },
  travail: {
    fichier: 'a-propos/travail.jpg',
    alt: 'Enzo Hillairet en train de coder sur son ordinateur portable',
    sujet: 'Toi en train de travailler : devant l’ordinateur avec une maquette Figma ou du code à l’écran, de trois quarts arrière, lumière naturelle.',
    format: '4/5' as any,
    taille: '1600 × 2000 px',
  },
  atelier: {
    fichier: 'a-propos/atelier.jpg',
    alt: 'Croquis et maquettes préparatoires',
    sujet: 'Tes croquis, wireframes ou maquettes imprimées étalés sur un bureau, vus de dessus.',
    format: '3/2' as const,
    taille: '2000 × 1333 px',
  },
  iut: {
    fichier: 'a-propos/iut.jpg',
    alt: 'L’IUT de Montbéliard',
    sujet: 'Une photo de ton quotidien d’étudiant : l’IUT de Montbéliard, la salle de projet ou un travail de groupe.',
    format: '3/2' as const,
    taille: '2000 × 1333 px',
  },
};
---

<Layout titre="À propos" description={`${profil.nom}, étudiant en BUT MMI à Montbéliard. ${profil.recherche}`} page="apropos" claire theme={couleurs}>
  <!-- Ouverture : grande phrase + portrait -->
  <section class="ap-hero" id="ap-hero" aria-labelledby="titre-ap">
    <!-- Une seule bande qui défile à l'horizontale : texte, portrait, puis les inspirations -->
    <div class="ap-bande" id="ap-bande" tabindex="0" role="region" aria-label="À propos et inspirations, faire défiler vers la droite">
      <div class="ap-bande__texte">
        <p class="ap-hero__etiquette">À propos</p>
        <h1 id="titre-ap">Enzo, étudiant en MMI. Je crée des identités visuelles qui <mark>vivent</mark> en ligne.</h1>
        <div class="ap-hero__actions">
          {aCv && <a class="ap-bouton ap-bouton--plein" href="#cv" data-cv>Télécharger mon CV <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path></svg></a>}
          <a class="ap-bouton" href="/contact">Me contacter</a>
        </div>
      </div>
      <div class="ap-bande__portrait"><Photo photo={photos.portrait} prioritaire /></div>
      <div class="ap-bande__insp">
        {galerie.map((g, i) => (
          <a
            class="ap-bande__case"
            href={g.lien}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Inspiration ${i + 1}${g.auteur ? `, de @${g.auteur}` : ''} : voir sur Pinterest`}
          >
            <img src={`/images/a-propos/${g.fichier}`} alt="" width="736" height="736" loading={i < 9 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
            <span class="ap-bande__credit" aria-hidden="true">{g.auteur ? `@${g.auteur}` : 'Voir sur Pinterest'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Pile de cartes : chaque carte est un chapitre, le défilement les fait passer une à une -->
  <div class="pile" id="pile" style={`--n:${7}`}>
    <div class="pile__scene">
      <div class="pile__cartes">

        <section class="pl pl--gris" style="--fond:#5ebd3e" data-etiquette="En bref" aria-labelledby="titre-bref">
          <div class="pl__corps pl__corps--bref">
            <div class="pl__texte">
              <h2 id="titre-bref" class="pl__titre">En bref</h2>
              <p class="pl__lead">J’ai {profil.age} ans, je suis en deuxième année de BUT MMI à Montbéliard.</p>
              <p class="pl__intro">J’imagine une identité visuelle, je la dessine sur Figma, puis je la code jusqu’à la mise en ligne. Du site à la vidéo en passant par l’affiche, c’est ce mélange entre design, communication et développement qui me plaît.</p>
              <p class="pl__intro">{profil.recherche}</p>
            </div>
            <div class="pl-photo"><Photo photo={photos.travail} serre /></div>
          </div>
        </section>

        <section class="pl pl--gris" style="--fond:#ffb900" data-etiquette="Démarche" aria-labelledby="titre-demarche">
          <div class="pl__corps pl__corps--colonne">
            <h2 id="titre-demarche" class="pl__titre">Ma démarche</h2>
            <ol class="pl__etapes">
              {
                demarche.map((e, i) => (
                  <li>
                    <span class="pl__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{e.titre}</h3>
                    <p>{e.texte}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        <section class="pl pl--gris" style="--fond:#f78200" data-etiquette="Compétences" aria-labelledby="titre-comp">
          <div class="pl__corps pl__corps--colonne">
            <h2 id="titre-comp" class="pl__titre">Compétences</h2>
            <div class="pl__comps">
              {
                competences.map((c) => (
                  <div>
                    <h3>{c.titre}</h3>
                    <ul>
                      {c.items.map((i) => <li>{i}</li>)}
                    </ul>
                  </div>
                ))
              }
            </div>
            </div>
        </section>

        <section class="pl pl--noir" style="--fond:#d12f2f" data-etiquette="Skills IA" aria-labelledby="titre-ia">
          <div class="pl__corps pl__corps--colonne">
            <h2 id="titre-ia" class="pl__titre">Skills IA</h2>
            <div class="pl__comps">
              {
                skillsIA.map((c) => (
                  <div>
                    <h3>{c.titre}</h3>
                    <ul>
                      {c.items.map((i) => <li>{i}</li>)}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        <section class="pl pl--noir" style="--fond:#973999" data-etiquette="Parcours" aria-labelledby="titre-parcours">
          <div class="pl__corps pl__corps--colonne">
            <h2 id="titre-parcours" class="pl__titre">Parcours</h2>
            <ol class="pl__parcours">
              {
                parcours.map((p) => (
                  <li>
                    <p class="pl__periode">{p.periode}</p>
                    <div>
                      <strong>{p.titre}</strong>
                      <span>{p.lieu}</span>
                    </div>
                    <p>{p.texte}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

      </div>
      <nav class="pile__points" aria-label="Chapitres" id="pile-points"></nav>
      <p class="pile__defiler" aria-hidden="true">Défiler ↓</p>
    </div>
  </div>

  <div class="pile-suite"><Contact /></div>
</Layout>

<script>
  // Bande du haut : le trackpad et le tactile la font défiler nativement (le plus fluide).
  // À la souris, on peut aussi la glisser, avec un peu d'inertie au lâcher.
  const bande = document.getElementById('ap-bande');


  if (bande) {
    let x0 = 0, s0 = 0, saisi = false, aGlisse = false, v = 0, dx = 0, dt = 0, raf = 0;
    const freiner = () => {
      if (Math.abs(v) < 0.05) { bande.classList.remove('est-saisi'); return; }
      bande.scrollLeft -= v * 16;
      v *= 0.95;
      raf = requestAnimationFrame(freiner);
    };
    bande.addEventListener('dragstart', (e) => e.preventDefault());
    bande.addEventListener('click', (e) => { if (aGlisse) { e.preventDefault(); e.stopPropagation(); aGlisse = false; } }, true);
    bande.addEventListener('pointerdown', (e) => {
      aGlisse = false; // un glissement précédent ne doit jamais bloquer un clic sur une image
      if (e.pointerType !== 'mouse' || e.button !== 0 || (e.target as HTMLElement).closest('a, button')) return;
      cancelAnimationFrame(raf);
      saisi = true; aGlisse = false; v = 0; x0 = dx = e.clientX; s0 = bande.scrollLeft; dt = performance.now();
    });
    window.addEventListener('pointermove', (e) => {
      if (!saisi) return;
      if (!aGlisse && Math.abs(e.clientX - x0) > 6) { aGlisse = true; bande.classList.add('est-saisi'); }
      if (!aGlisse) return;
      bande.scrollLeft = s0 - (e.clientX - x0);
      const t = performance.now();
      if (t > dt) v = 0.7 * v + 0.3 * ((e.clientX - dx) / (t - dt));
      dx = e.clientX; dt = t;
    });
    window.addEventListener('pointerup', () => {
      if (!saisi) return;
      saisi = false;
      if (aGlisse) raf = requestAnimationFrame(freiner); else bande.classList.remove('est-saisi');
    });
  }
  const pile = document.getElementById('pile');
  const cartes = pile ? Array.from(pile.querySelectorAll<HTMLElement>('.pl')) : [];
  const points = document.getElementById('pile-points');
  const mq = window.matchMedia('(min-width: 48.01rem) and (prefers-reduced-motion: no-preference)');

  if (pile && cartes.length) {
    const N = cartes.length;
    pile.style.setProperty('--n', String(N + 1));
    const boutons: HTMLButtonElement[] = [];
    cartes.forEach((c, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pile__point';
      b.setAttribute('aria-label', `${String(i + 1).padStart(2, '0')} ${c.dataset.etiquette ?? ''}`);
      b.innerHTML = `<span>${c.dataset.etiquette ?? ''}</span>`;
      b.addEventListener('click', () => {
        const haut = pile.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: haut + i * window.innerHeight, behavior: 'smooth' });
      });
      points?.appendChild(b);
      boutons.push(b);
      const e = document.createElement('span');
      e.className = 'pl__onglet';
      e.textContent = `${String(i + 1).padStart(2, '0')}  ${c.dataset.etiquette ?? ''}`;
      c.prepend(e);
    });

    const clamp = (x: number, a = 0, b = 1) => Math.min(b, Math.max(a, x));
    const debutPile = () => pile.getBoundingClientRect().top + window.scrollY;
    const aller = (i: number) => window.scrollTo({ top: debutPile() + i * window.innerHeight, behavior: 'smooth' });

    // progression « visée » (lue au défilement) et progression « affichée » (rattrape la visée en douceur)
    let vise = 0;
    let affiche = 0;
    let dernier = performance.now();
    let actif = -1;
    let enBoucle = false;

    const lire = () => { vise = clamp((window.scrollY - debutPile()) / window.innerHeight, 0, N); };

    const dessiner = () => {
      const p = affiche;
      const proche = Math.round(p);
      cartes.forEach((c, i) => {
        const d = i - p;
        if (d <= 0) {
          // la carte tombe vers l'écran : elle bascule vers nous, grossit et s'efface
          const t = clamp(-d);
          const e = t * t;
          c.style.transformOrigin = '50% 100%';
          c.style.transform = `translate3d(0, ${e * 18}vh, ${e * 900}px) rotateX(${-e * 55}deg)`;
          c.style.opacity = String(1 - clamp((t - 0.55) / 0.35));
          c.style.visibility = t >= 1 ? 'hidden' : 'visible';
        } else {
          const k = Math.min(d, 4.2);
          c.style.transformOrigin = '50% 0';
          c.style.transform = `translate3d(0, calc(var(--pas) * ${-k}), ${-k * 40}px) scale(${1 - k * 0.045})`;
          c.style.opacity = String(1 - clamp((d - 3) / 1.2));
          c.style.visibility = d > 4.2 ? 'hidden' : 'visible';
        }
        // le contenu des cartes de derrière s'efface : à travers le verre on ne voit que leur couleur
        const corps = c.querySelector<HTMLElement>('.pl__corps');
        if (corps) corps.style.opacity = d > 0 ? String(clamp(1 - (d - 0.1) * 2.4)) : '1';
        c.style.zIndex = String(N - i);
        c.style.pointerEvents = d <= -1 || d > 3.4 ? 'none' : 'auto';
        c.classList.toggle('pl--derriere', i > proche);
      });
      if (proche !== actif) {
        actif = proche;
        boutons.forEach((b, i) => b.setAttribute('aria-current', i === proche ? 'true' : 'false'));
        pile.classList.toggle('pile--fin', proche === N - 1);
      }
    };

    const boucle = (maintenant: number) => {
      const dt = Math.min(0.05, (maintenant - dernier) / 1000);
      dernier = maintenant;
      affiche += (vise - affiche) * (1 - Math.exp(-dt * 16));
      if (Math.abs(vise - affiche) < 0.0004) affiche = vise;
      dessiner();
      if (affiche !== vise) requestAnimationFrame(boucle);
      else enBoucle = false;
    };
    const lancer = () => { if (!enBoucle) { enBoucle = true; dernier = performance.now(); requestAnimationFrame(boucle); } };

    const statique = () => {
      pile.classList.add('pile--statique');
      cartes.forEach((c) => { const co = c.querySelector<HTMLElement>('.pl__corps'); if (co) co.style.opacity = ''; c.style.transform = ''; c.style.opacity = ''; c.style.visibility = ''; c.style.zIndex = ''; c.style.pointerEvents = ''; c.style.transformOrigin = ''; c.classList.remove('pl--derriere'); });
    };

    const auDefilement = () => {
      if (!mq.matches) { statique(); return; }
      pile.classList.remove('pile--statique');
      lire();
      lancer();
    };

    // cliquer sur une carte qui dépasse derrière la carte du devant la ramène devant
    cartes.forEach((c, i) => {
      c.addEventListener('click', (ev) => {
        if (!mq.matches || i <= actif || (ev.target as HTMLElement).closest('a, button')) return;
        aller(i);
      });
    });

    window.addEventListener('scroll', auDefilement, { passive: true });
    window.addEventListener('resize', () => { auDefilement(); });
    mq.addEventListener('change', auDefilement);
    if (mq.matches) { lire(); affiche = vise; pile.classList.remove('pile--statique'); dessiner(); } else statique();
  }
</script>
